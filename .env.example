# --- Groq (recommended) — OpenAI-compatible API ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI (alternative) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Groq is used if GROQ_API_KEY is set; otherwise OpenAI.

# Set to 1 to force deterministic fallback for no-secret reproducibility checks.
DISABLE_LLM=0

# Path to CeRAI AI Evaluation Tool clone (for full pipeline)
CERAI_ROOT=../AIEvaluationTool

# Set to 1 to attempt Docker-based CeRAI execution
CERAI_RUN_DOCKER=0
